# ---------------------------------------------------------------------------
# Copy to .env — every value below has a working default for local development.
# ---------------------------------------------------------------------------

# --- core ---
APP_NAME="Last-Mile Delivery Tracker"
ENV=development
# SQLite locally; on Render/Railway paste the Postgres URL (postgres:// is fine,
# it gets rewritten for SQLAlchemy 2.x automatically)
DATABASE_URL=sqlite:///./lastmile.db

# --- auth ---
# CHANGE THIS before deploying:  python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=720

# --- bootstrap admin (created on first boot) ---
ADMIN_EMAIL=admin@lastmile.dev
ADMIN_PASSWORD=Admin@123

# --- behaviour ---
AUTO_SEED_ON_BOOT=true
NOTIFICATIONS_ENABLED=true
PUBLIC_BASE_URL=http://localhost:8000
CORS_ORIGINS=*

# --- email (optional) -------------------------------------------------------
# Leave blank and every email is recorded in the notifications table with
# status SIMULATED and written to the log, so the flow stays demonstrable.
# Brevo free tier: smtp-relay.brevo.com / 587 / your login / your SMTP key
# Gmail: smtp.gmail.com / 587 / your address / a 16-char app password
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true
MAIL_FROM=no-reply@lastmile.dev
MAIL_FROM_NAME="Last-Mile Tracker"

# --- sms (optional) ---------------------------------------------------------
# twilio | fast2sms | blank for simulated
SMS_PROVIDER=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
FAST2SMS_API_KEY=
